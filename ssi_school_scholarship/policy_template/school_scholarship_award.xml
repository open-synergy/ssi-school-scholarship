<odoo>
<record id="policy_template_school_scholarship_award" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_school_scholarship_award" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','school_scholarship_award'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Confirm -->
<record
        id="policy_template_school_scholarship_award_confirm"
        model="policy.template_detail"
    >
    <field name="template_id" ref="policy_template_school_scholarship_award" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_scholarship_award'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_scholarship_award'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('school_scholarship_award_user_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>

