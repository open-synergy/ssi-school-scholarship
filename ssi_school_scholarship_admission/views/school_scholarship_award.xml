<odoo>

<record id="school_scholarship_award_view_form_admission" model="ir.ui.view">
    <field name="name">school_scholarship_award form - admission</field>
    <field name="model">school_scholarship_award</field>
    <field
            name="inherit_id"
            ref="ssi_school_scholarship.school_scholarship_award_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='enrollment_id']" position="after">
                <field
                        name="admission_id"
                        domain="[('state', 'in', ['open', 'done'])]"
                        attrs="{'required': [('source_type', '=', 'admission')], 'invisible': [('source_type', '!=', 'admission')]}"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
