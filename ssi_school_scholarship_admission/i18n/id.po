msgstr "Nama Tampilan"

#. module: ssi_school_scholarship_admission
#: model:ir.model.fields,help:ssi_school_scholarship_admission.field_school_admission__amount_scholarship_deduction
msgid ""
"Effective scholarship deduction: Scholarship Deducted plus Scholarship Not "
"Yet Deducted. The part of a partially realized schedule line that was not "
"deducted stays billable and is deliberately not counted."
msgstr ""
"Potongan beasiswa efektif: Beasiswa Terpotong ditambah Beasiswa Belum "
"Terpotong. Bagian dari baris jadwal yang terealisasi sebagian dan tidak "
"dipotong tetap dapat ditagih dan sengaja tidak dihitung."

#. module: ssi_school_scholarship_admission
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_admission__id
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_admission_payment_term__id
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_scholarship_award__id
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_scholarship_award_schedule__id
msgid "ID"
msgstr "ID"

#. module: ssi_school_scholarship_admission
