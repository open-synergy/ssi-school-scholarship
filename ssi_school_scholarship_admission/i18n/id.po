#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_admission__amount_scholarship
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_admission_payment_term__scholarship_amount
msgid "Scholarship Amount"
msgstr "Jumlah Beasiswa"

#. module: ssi_school_scholarship_admission
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_admission__scholarship_award_count
msgid "Scholarship Award Count"
msgstr "Jumlah Pemberian Beasiswa"

#. module: ssi_school_scholarship_admission
#: model:ir.model.fields,field_description:ssi_school_scholarship_admission.field_school_admission__scholarship_award_ids
