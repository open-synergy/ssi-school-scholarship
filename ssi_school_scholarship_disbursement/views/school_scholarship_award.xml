<odoo>
<record
        id="school_scholarship_award_view_form_create_due_disbursement"
        model="ir.ui.view"
    >
    <field name="name">school_scholarship_award form - create due disbursement</field>
    <field name="model">school_scholarship_award</field>
    <field
            name="inherit_id"
            ref="ssi_school_scholarship.school_scholarship_award_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//header" position="inside">
                <button
                        name="action_open_create_due_disbursement_wizard"
                        type="object"
                        string="Create Due Disbursement"
                        class="oe_highlight"
                    />
            </xpath>
        </data>
    </field>
</record>

<record
        id="school_scholarship_award_view_tree_create_due_disbursement"
        model="ir.ui.view"
    >
    <field name="name">school_scholarship_award tree - create due disbursement</field>
    <field name="model">school_scholarship_award</field>
    <field
            name="inherit_id"
            ref="ssi_school_scholarship.school_scholarship_award_view_tree"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//header" position="inside">
                <button
                        name="action_open_create_due_disbursement_wizard"
                        type="object"
                        string="Create Due Disbursement"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
