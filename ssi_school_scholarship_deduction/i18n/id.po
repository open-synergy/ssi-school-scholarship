#. module: ssi_school_scholarship_deduction
#: code:addons/ssi_school_scholarship_deduction/wizards/create_due_scholarship_deduction.py:0
#, python-format
msgid ""
"\n"
"Context: Create due scholarship deduction\n"
"Database ID: %s\n"
"Problem: No Deduction document was created for the selected Award(s)\n"
"Solution: Check that the period's invoice has already been issued\n"
msgstr ""
"\n"
"Konteks: Membuat potongan beasiswa jatuh tempo\n"
"ID Basis Data: %s\n"
"Masalah: Tidak ada dokumen Potongan yang dibuat untuk Pemberian yang "
"dipilih\n"
"Solusi: Periksa apakah faktur periode tersebut sudah diterbitkan\n"

#. module: ssi_school_scholarship_deduction
#: code:addons/ssi_school_scholarship_deduction/wizards/create_due_scholarship_recognition.py:0
#, python-format
msgid ""
"\n"
"Context: Create due scholarship recognition\n"
"Database ID: %s\n"
"Problem: No Deduction is due for recognition as of the selected Date\n"
"Solution: Pick a later Date, or check the deductions' own Recognition Date\n"
msgstr ""
"\n"
"Konteks: Membuat pengakuan beasiswa jatuh tempo\n"
"ID Basis Data: %s\n"
"Masalah: Tidak ada Potongan yang jatuh tempo untuk diakui per Tanggal yang "
"dipilih\n"
"Solusi: Pilih Tanggal yang lebih akhir, atau periksa Tanggal Pengakuan milik "
"potongan itu sendiri\n"

#. module: ssi_school_scholarship_deduction
#: code:addons/ssi_school_scholarship_deduction/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Finish enrollment\n"
"Database ID: %s\n"
"Problem: Scholarship deduction '%s' on this enrollment's own invoice is not "
"yet Open\n"
"Solution: Confirm and approve that deduction before finishing this "
"enrollment\n"
msgstr ""
"\n"
"Konteks: Menyelesaikan pendaftaran\n"
"ID Basis Data: %s\n"
"Masalah: Potongan beasiswa '%s' pada faktur pendaftaran ini sendiri belum "
"berstatus Terbuka\n"
"Solusi: Konfirmasi dan setujui potongan tersebut sebelum menyelesaikan "
"pendaftaran ini\n"

